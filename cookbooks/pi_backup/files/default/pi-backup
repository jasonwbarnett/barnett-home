#!/usr/bin/env bash
# Bootable image backup of this Pi, shipped offsite with restic.
#
# 1. image-backup keeps $IMAGE_DIR/<hostname>.img up to date: a raw disk
#    image that can be flashed with Raspberry Pi Imager ("Use custom") to a
#    new SD card or SSD. The first run makes a full image; later runs rsync
#    changes into it. image-backup never copies /mnt, so the image doesn't
#    contain itself.
# 2. restic uploads the image. Its dedup means only the changed blocks go up.
#
# Managed by Chef (cookbook pi_backup). Config: /etc/pi-backup/pi-backup.conf;
# secrets: /etc/pi-backup/restic.env (RESTIC_REPOSITORY, RESTIC_PASSWORD,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, optional HC_PING_URL).
set -euo pipefail

# shellcheck source=/dev/null
. /etc/pi-backup/pi-backup.conf   # IMAGE_DIR, KEEP_*
SECRETS=/etc/pi-backup/restic.env
[[ -r $SECRETS ]] || { echo "missing $SECRETS"; exit 1; }
set -a
# shellcheck source=/dev/null
. "$SECRETS"
set +a

HOST=$(hostname -s)
IMG="$IMAGE_DIR/$HOST.img"

# rsync additions: keep ACLs/xattrs (file capabilities live in xattrs) and
# skip Docker's mounted container views, which Docker recreates at start.
RSYNC_OPTS='-AX,--exclude=/var/lib/docker/overlay2/*/merged'

log() { echo "$(date -Is) $*"; }

# healthchecks.io-style dead man's switch: no ping in a day → alert.
ping_hc() { [[ -n ${HC_PING_URL:-} ]] && curl -fsS -m 10 --retry 3 "$HC_PING_URL$1" >/dev/null || true; }
ping_hc /start
trap 'rc=$?; ((rc)) && ping_hc /fail; exit $rc' EXIT

install -d -m 0700 "$IMAGE_DIR"

log "running pre-backup hooks"
run-parts --verbose --exit-on-error /etc/pi-backup/pre.d

full_backup() {
  local target=$1 used_mb img_mb=0 size_mb headroom_mb
  used_mb=$(( $(df --output=used -k / | tail -1) / 1024 ))
  # The existing image sits on / too; don't count it as data to back up.
  [[ -f $IMG ]] && img_mb=$(( $(du -k "$IMG" | cut -f1) / 1024 ))
  used_mb=$(( used_mb - img_mb ))
  size_mb=$(( used_mb * 6 / 5 ))
  # Room for incremental growth after image-backup shrinks the filesystem:
  # a quarter of current usage, at least 4 GB.
  headroom_mb=$(( used_mb / 4 > 4096 ? used_mb / 4 : 4096 ))
  rm -f "$target"
  log "full backup to $target (${size_mb} MB, headroom ${headroom_mb} MB)"
  image-backup -o "$RSYNC_OPTS" -i "$target,$size_mb,$headroom_mb" </dev/null
}

if [[ -f $IMG ]]; then
  log "incremental backup to $IMG"
  if ! image-backup -o "$RSYNC_OPTS" "$IMG" </dev/null; then
    # Usually the image ran out of headroom. Rebuild beside it so a failure
    # here leaves the old image in place.
    log "incremental failed; rebuilding a fresh image"
    full_backup "$IMG.new"
    mv -f "$IMG.new" "$IMG"
  fi
else
  full_backup "$IMG.new"
  mv -f "$IMG.new" "$IMG"
fi

log "uploading $(du -h --apparent-size "$IMG" | cut -f1) image"
restic backup --retry-lock 2h --host "$HOST" --tag pi-image "$IMG"

restic forget --retry-lock 2h --host "$HOST" --tag pi-image --prune \
  --keep-daily "$KEEP_DAILY" --keep-weekly "$KEEP_WEEKLY" --keep-monthly "$KEEP_MONTHLY"

# Read back a different 1/30th of the repo each night, so it all gets
# verified monthly without downloading it at once.
restic check --retry-lock 2h --read-data-subset="$(( $(date +%-d) % 30 + 1 ))/30"

ping_hc ""
log "done"
